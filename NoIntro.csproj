<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="Paths.props" />
	
	<PropertyGroup>
		<AssemblyName>NoIntro</AssemblyName>
		<Description>can this just be a setting ingame hakita</Description>
		<Version>1.0.0</Version>

		<TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>14</LangVersion>
    <DebugType>embedded</DebugType>
    <NoWarn>IDE0130, IDE0251, IDE0062</NoWarn>

		<RestoreAdditionalProjectSources>
			https://api.nuget.org/v3/index.json;
			https://nuget.bepinex.dev/v3/index.json
		</RestoreAdditionalProjectSources>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="BepInEx.Core" Version="5.4.21" />
		<PackageReference Include="UnityEngine.Modules" Version="2022.3.29" IncludeAssets="compile" />

		<Reference Include="$(ManagedPath)\Assembly-CSharp.dll" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="Build">
		<Message Text="Copying DLL to: $(CopyPath)..." Importance="high" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CopyPath)" OverwriteReadOnlyFiles="true" />
	</Target>
</Project>
